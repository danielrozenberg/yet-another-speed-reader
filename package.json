{
  "name": "yet-another-speed-reader",
  "version": "1.0.4",
  "description": "Yet another Firefox extension for speed reading",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/danielrozenberg/yet-another-speed-reader"
  },
  "scripts": {
    "build": "npm run clean && npm run build:static && npm run build:esbuild",
    "build:static": "cp -r static/* dist/",
    "build:esbuild": "tsx build.ts",
    "clean": "rm -rf dist/ && mkdir dist/",
    "lint": "eslint ."
  },
  "author": "Daniel Rozenberg",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@eslint/json": "1.2.0",
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@types/webextension-polyfill": "0.12.5",
    "esbuild": "0.28.0",
    "eslint": "10.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "globals": "17.6.0",
    "jsx-dom": "8.1.6",
    "prettier": "3.8.3",
    "tsx": "4.21.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.59.2"
  }
}
